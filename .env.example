# Copy to .env.local and fill in for local dev.
# Same Supabase project as app.english-coding — reuses session_token model.
VITE_SUPABASE_URL=https://<project>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
VITE_APP_URL=https://app.english-coding.co.uk
VITE_CODE_EXECUTOR_URL=https://<droplet-host>
